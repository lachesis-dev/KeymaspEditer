// 利便性を考えて、デフォルトではなくhttps://jurf.github.io/2023/07/11/60-percent-miryoku/ベース　Mityoku（QWERTY）配列

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        back {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
            layers = <0 1 2 6>;
        };

        ZenHan {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────
        // BASE（jurf 60% Miryoku　Base）
        // ─────────────────────────────

        base_layer {
            display-name = "BASE";
            bindings = <
       &kp Q  &kp W  &kp E        &kp R  &kp T        &kp Y      &kp U  &kp I          &kp O    &kp P
       &kp A  &kp S  &kp D        &kp F  &kp G        &kp H      &kp J  &kp K          &kp L    &kp SEMICOLON
&mo 5  &kp Z  &kp X  &kp C        &kp V  &kp B        &kp N      &kp M  &kp COMMA      &kp DOT  &kp FSLH       &kp FSLH
                     &lt 1 SPACE  &mo 2  &kp SPACE    &kp ENTER  &mo 3  &kp BACKSPACE
            >;
        };

        // ─────────────────────────────
        // NAVI
        // ─────────────────────────────

        num_layer {
            display-name = "NUM";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp SLASH        &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
        &trans  &trans  &trans  &trans  &trans    &kp RBKT         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp RPAR         &kp KP_N1  &kp KP_N2  &kp KP_N3  &lt 5 KP_ENTER  &trans
                        &trans  &trans  &trans    &kp KP_NUMBER_0  &trans     &trans
            >;
        };

        // ─────────────────────────────
        // SYM
        // ─────────────────────────────

        lower_layer {
            display-name = "lower";
            bindings = <
        &kp EXCL        &kp DOUBLE_QUOTES  &kp HASH       &kp DLLR      &kp PRCNT     &kp CARET     &kp AMPERSAND              &kp ASTRK      &kp INSERT  &kp PAUSE_BREAK
        &kp CAPSLOCK    &kp TAB            &kp BACKSPACE  &kp ESCAPE    &kp DELETE    &kp QUESTION  &kp UNDER                  &kp PLUS       &kp PIPE    &kp AT_SIGN
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL   &kp LEFT_ALT   &kp LEFT_GUI  &mo 8         &trans        &kp RIGHT_GUI              &kp RIGHT_ALT  &kp RCTRL   &kp RIGHT_SHIFT  &trans
                                           &trans         &trans        &kp ENTER     &kp ENTER     &lt 7 LANG_ZENKAKUHANKAKU  &trans
            >;
        };

        // ─────────────────────────────
        // KeyMove
        // ─────────────────────────────

        raise_layer {
            display-name = "raise";
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4               &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &kp NUMBER_0
        &kp LPAR      &kp RPAR      &kp LBKT      &kp RBKT                   &kp LBRC        &kp RBRC      &kp MINUS     &kp EQUAL     &kp BACKSLASH  &kp SQT
&trans  &trans        &trans        &trans        &trans                     &none           &kp GRAVE     &trans        &trans        &trans         &trans        &trans
                                    &trans        &lt 6 LANG_ZENKAKUHANKAKU  &kp ENTER       &trans        &lt 8 ENTER   &trans
            >;
        };

        // ─────────────────────────────
        // MouseMove
        // ─────────────────────────────

        mmov_layer {
            display-name = "MouseMove";
            bindings = <
       &none         &mkp LCLK     &mkp MCLK  &mkp RCLK   &none     &none   &mkp LCLK       &mkp MCLK       &mkp RCLK        &msc SCRL_UP
       &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &none     &none   &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_DOWN
&none  &none         &none         &none      &none       &none     &none   &none           &mmv MOVE_DOWN  &msc SCRL_LEFT   &msc SCRL_RIGHT  &none
                                   &trans     &trans      &trans    &trans  &trans          &trans
            >;
        };

        // ─────────────────────────────
        // BLT
        // ─────────────────────────────

        func_layer {
            display-name = "func";
            bindings = <
        &bt BT_NXT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &sys_reset  &bootloader  &studio_unlock  &trans  &trans
        &bt BT_PRV  &bt BT_SEL 4  &trans        &ind_bat      &ind_con        &trans      &trans       &trans          &trans  &trans
&trans  &bt BT_CLR  &trans        &trans        &trans        &out OUT_TOG    &trans      &trans       &trans          &trans  &trans  &trans
                                  &trans        &trans        &trans          &trans      &trans       &trans
            >;
        };

        // ─────────────────────────────
        // ADJ
        // ─────────────────────────────

        lmod_layer {
            display-name = "lmod";
            bindings = <
       &kp F1   &kp F2   &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F12
       &kp F10  &kp F11  &none   &none   &none     &none   &none   &none   &none   &none
&none  &none    &none    &none   &none   &none     &none   &none   &none   &none   &none    &none
                         &none   &none   &none     &none   &none
            >;
        };

        rmod_layer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        adjust_layer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
