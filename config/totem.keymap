// 利便性を考えて、デフォルトではなくhttps://github.com/note96e/thorium/ ベース　Mityoku（QWERTY）配列

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        back {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
            layers = <0 6 1 7>;
        };

        ZenHan {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────
        // BASE（jurf 60% Miryoku　Base）
        // ─────────────────────────────

        base_layer {
            display-name = "BASE";
            bindings = <
           &kp Q  &kp W  &kp E  &kp R        &kp T      &kp Y      &kp U            &kp I         &kp O    &kp P
           &kp A  &kp S  &kp D  &kp F        &kp G      &kp H      &kp J            &kp K         &kp L    &kp MINUS
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V        &kp B      &kp N      &kp M            &kp COMMA     &kp DOT  &lt 4 SLASH  &kp ENTER
                         &none  &lt 1 SPACE  &kp TAB    &kp ENTER  &lt 2 BACKSPACE  &lt 3 DELETE
            >;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
        &kp EXCL        &kp DOUBLE_QUOTES  &kp HASH       &kp DLLR      &kp PRCNT     &kp CARET     &kp AMPERSAND              &kp ASTRK      &kp INSERT  &kp PAUSE_BREAK
        &kp CAPSLOCK    &kp TAB            &kp BACKSPACE  &kp ESCAPE    &kp DELETE    &kp QUESTION  &kp UNDER                  &kp PLUS       &kp PIPE    &kp AT_SIGN
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL   &kp LEFT_ALT   &kp LEFT_GUI  &mo 8         &trans        &kp RIGHT_GUI              &kp RIGHT_ALT  &kp RCTRL   &kp RIGHT_SHIFT  &trans
                                           &trans         &mo 1         &kp ENTER     &kp ENTER     &lt 7 LANG_ZENKAKUHANKAKU  &trans
            >;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4               &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &kp NUMBER_0
        &kp LPAR      &kp RPAR      &kp LBKT      &kp RBKT                   &kp LBRC        &kp RBRC      &kp MINUS     &kp EQUAL     &kp BACKSLASH  &kp SQT
&trans  &trans        &trans        &trans        &trans                     &none           &kp GRAVE     &trans        &trans        &trans         &trans        &trans
                                    &trans        &lt 7 LANG_ZENKAKUHANKAKU  &kp ENTER       &trans        &lt 8 ENTER   &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
        &kp ESCAPE      &mkp LCLK  &mkp MCLK     &mkp RCLK     &none     &mkp MCLK        &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP
        &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &none     &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&trans  &none           &none      &none         &none         &none     &msc SCRL_RIGHT  &kp LEFT        &kp DOWN        &kp UP           &kp RIGHT       &trans
                                   &trans        &trans        &trans    &trans           &trans          &trans
            >;
        };

        func_layer {
            display-name = "func";
            bindings = <
        &kp F1      &kp F2  &kp F3  &kp F4  &kp F5          &kp F11        &kp F12         &kp UP_ARROW    &kp HOME         &kp END
        &kp F6      &kp F7  &kp F8  &kp F9  &kp F10         &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &tog 6
&trans  &bt BT_CLR  &trans  &trans  &trans  &out OUT_TOG    &kp PAGE_DOWN  &kp RIGHT_GUI   &kp RCTRL       &kp RIGHT_SHIFT  &none    &trans
                            &trans  &none   &kp SPACE       &kp RIGHT_ALT  &kp LEFT_GUI    &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp SLASH        &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
        &trans  &trans  &trans  &trans  &trans    &kp ASTERISK     &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp TAB          &kp KP_N1  &kp KP_N2  &kp KP_N3  &lt 4 KP_ENTER  &trans
                        &trans  &trans  &trans    &kp KP_NUMBER_0  &trans     &trans
            >;
        };

        lmod_layer {
            display-name = "lmod";
            bindings = <
       &kp C_VOL_DN     &kp C_VOL_UP  &kp K_MUTE     &none          &none        &kp Y      &kp U   &kp I      &kp O       &kp P
       &kp LEFT_SHIFT   &kp LCTRL     &kp LEFT_ALT   &kp LEFT_GUI   &none        &kp H      &kp J   &kp K      &kp L       &kp SEMICOLON
&none  &kp RIGHT_SHIFT  &kp RCTRL     &kp RIGHT_ALT  &kp RIGHT_GUI  &none        &kp N      &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &none
                                      &none          &trans         &kp SPACE    &kp SPACE  &trans
            >;
        };

        rmod_layer {
            bindings = <
        &kp Q  &kp W  &kp E   &kp R   &kp T     &trans  &trans         &trans         &trans     &trans
        &kp A  &kp S  &kp D   &kp F   &kp G     &trans  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RCTRL  &kp RIGHT_SHIFT
&trans  &kp Z  &kp X  &kp C   &kp V   &kp B     &trans  &kp LEFT_GUI   &kp LEFT_ALT   &kp LCTRL  &kp LEFT_SHIFT   &trans
                      &trans  &trans  &trans    &trans  &trans         &trans
            >;
        };

        adjust_layer {
            bindings = <
        &bootloader   &sys_reset    &none         &none           &none           &trans          &trans  &trans  &trans  &trans
        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4    &none           &none   &none   &none   &none
&trans  &out OUT_USB  &out OUT_USB  &bt BT_CLR    &bt BT_CLR_ALL  &mo 8           &studio_unlock  &none   &none   &none   &trans  &trans
                                    &trans        &trans          &trans          &trans          &trans  &trans
            >;
        };
    };
};
